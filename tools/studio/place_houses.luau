local Storage = game:GetService("ServerStorage")

for _, old in { Storage:FindFirstChild("HouseKit"), workspace:FindFirstChild("HousePack") } do
	old:Destroy()
end

local loaded = game:GetService("InsertService"):LoadAsset(DATA.Model)
local meshes = {}
for _, d in loaded:GetDescendants() do
	if d:IsA("MeshPart") then
		meshes[d.Name] = d
	end
end

local kit = Instance.new("Folder")
kit.Name = "HouseKit"
local report = {}
for house, info in DATA.Houses do
	local model = Instance.new("Model")
	model.Name = house
	for sheet, part in info.Parts do
		local mesh = meshes[house .. "_" .. sheet]
		assert(mesh, "no mesh for " .. house .. "_" .. sheet)
		local p = mesh:Clone()
		p.Name = sheet
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CastShadow = true
		p.TextureID = ""
		for _, c in p:GetChildren() do
			c:Destroy()
		end
		local sa = Instance.new("SurfaceAppearance")
		sa.ColorMap = part.Id
		sa.Parent = p
		local b = part.Bounds
		-- the importer turns these meshes half way round their own centres, so each is turned back
		p.CFrame = CFrame.new((b[1] + b[4]) / 2, (b[2] + b[5]) / 2, (b[3] + b[6]) / 2) * CFrame.Angles(0, math.pi, 0)
		local want = Vector3.new(b[4] - b[1], b[5] - b[2], b[6] - b[3])
		if (p.Size - want).Magnitude > 0.2 then
			table.insert(report, house .. "_" .. sheet .. " size " .. tostring(p.Size) .. " wanted " .. tostring(want))
		end
		p.Parent = model
	end
	for _, c in info.Collide do
		local box = Instance.new("Part")
		box.Name = "Collider"
		box.Anchored = true
		box.Transparency = 1
		box.CanTouch = false
		box.CastShadow = false
		box.Locked = true
		box.Size = Vector3.new(c[4], c[5], c[6])
		box.CFrame = CFrame.new(c[1], c[2], c[3]) * CFrame.Angles(math.rad(c[7] or 0), 0, 0)
		box.Parent = model
	end
	model.WorldPivot = CFrame.new()
	model.Parent = kit
end
loaded:Destroy()
kit.Parent = Storage

-- the shelf
local pack = Instance.new("Folder")
pack.Name = "HousePack"
local rock = workspace.RockPack.ShelfGround
local ground = rock:Clone()
ground.Size = Vector3.new(rock.Size.X, rock.Size.Y, 270)
ground.Position = Vector3.new(rock.Position.X, rock.Position.Y, 552.3 + 135)
ground.Parent = pack
local houses = Instance.new("Folder")
houses.Name = "Houses"
houses.Parent = pack
local labels = Instance.new("Folder")
labels.Name = "Labels"
labels.Parent = pack
for _, master in kit:GetChildren() do
	local where = DATA.Houses[master.Name].Shelf
	local m = master:Clone()
	-- the doors look back at the rock shelf, into the sun
	m:PivotTo(CFrame.new(where[1], 0, where[2]) * CFrame.Angles(0, math.pi, 0))
	m.Parent = houses
	local _, size = m:GetBoundingBox()
	local tag = Instance.new("Part")
	tag.Name = master.Name
	tag.Anchored = true
	tag.CanCollide = false
	tag.CanTouch = false
	tag.CanQuery = false
	tag.Transparency = 1
	tag.Size = Vector3.one
	tag.Position = Vector3.new(where[1], size.Y + 4, where[2])
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(192, 32)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 400
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBold
	text.TextSize = 16
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.3
	text.Text = master.Name
	text.Parent = gui
	gui.Parent = tag
	tag.Parent = labels
end
pack.Parent = workspace

-- the first test cottage had the old look: gone, and the grey boxes it had hidden come back
local land = workspace:FindFirstChild("Land1")
if not land then
	game:GetService("ChangeHistoryService"):SetWaypoint("Add house kit")
	return game:GetService("HttpService"):JSONEncode({ houses = #kit:GetChildren(), mismatches = report, note = "no Workspace.Land1 here" })
end
local test = land:FindFirstChild("Cottages")
if test then
	test:Destroy()
	for _, b in land.Blocks:GetChildren() do
		if (b.Name == "Planned" or b.Name == "PlannedRoof") and (Vector3.new(b.Position.X, 0, b.Position.Z) - Vector3.new(-4847, 0, 1220)).Magnitude < 5 then
			b.Transparency = 0.15
			b.CanCollide = true
		end
	end
end
local oldKit = Storage:FindFirstChild("CottageKit")
if oldKit then
	oldKit:Destroy()
end

game:GetService("ChangeHistoryService"):SetWaypoint("Add house kit")
return game:GetService("HttpService"):JSONEncode({ houses = #kit:GetChildren(), mismatches = report })
