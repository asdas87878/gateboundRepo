*.blend1
art/**/renders/*.tmp
Packages/
sourcemap.json

# look passes: the raw 16-bit renders are rebuilt by tools/look_pass.py; final/sheet/side/stats/spec are kept
art/look/*/passes/*/beauty.png
art/look/*/passes/*/depth.png
art/look/*/passes/*/scene.blend
art/look/*/passes/*/final.png
art/look/*/passes/*/placements.json

# reference study media (downloaded footage, frames): private, never in the repo
research/

# land beauty passes: keep each pass's sheet.jpg and the final frames; raw renders, depth, logs and the sky cache are
# rebuilt by tools/blender/vale_beauty.py
art/lands/*/beauty/_cache/
art/lands/*/beauty/v*/*/
art/lands/*/beauty/w*/*/
art/lands/*/beauty/*/blender_out.txt
art/lands/*/beauty/*/log.txt
art/lands/*/beauty/*/*.blend
art/lands/*/beauty/final/*/beauty.png
art/lands/*/beauty/final/*/depth.png
art/lands/*/beauty/final/*/placements.json
# grass bench, A/B runs and tree comparisons: keep the sheets
art/style/trees/*.png
art/style/grass/vale_ab/*/
art/style/grass/bench1/*.png

# Python build files
__pycache__/

# Obsidian (the repo is the vault): the settings are kept, each person's window layout and the trash are not
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/
# plugin code is downloaded (reinstall from Obsidian's community plugins); each plugin's settings (data.json) are kept
.obsidian/plugins/*/*
!.obsidian/plugins/*/data.json
